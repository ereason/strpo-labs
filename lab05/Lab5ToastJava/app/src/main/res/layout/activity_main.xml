<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/screen_title"
        android:textColor="@color/lab_primary_dark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/screen_subtitle"
        android:textColor="@color/lab_text"
        android:textSize="17sp" />

    <Button
        android:id="@+id/textToastButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/lab_primary"
        android:minHeight="56dp"
        android:text="@string/show_text_toast"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/imageToastButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/lab_primary"
        android:minHeight="56dp"
        android:text="@string/show_image_toast"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/customToastButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/lab_accent"
        android:minHeight="56dp"
        android:text="@string/show_custom_toast"
        android:textColor="@color/lab_text" />

</LinearLayout>
