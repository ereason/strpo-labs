<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/links_title"
            android:textColor="@color/navy"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="26dp"
            android:gravity="center"
            android:text="@string/links_instruction"
            android:textColor="@color/navy_muted"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/webLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/exampleLink"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:buttonTint="@color/teal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/example_link_label"
                android:textColor="@color/navy"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/nstuLink"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:buttonTint="@color/teal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/nstu_link_label"
                android:textColor="@color/navy"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/kotlinLink"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:buttonTint="@color/teal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/kotlin_link_label"
                android:textColor="@color/navy"
                android:textSize="18sp" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openLinkButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:text="@string/open_web_link"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/linksBackButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/back_to_menu"
            android:textAllCaps="false"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
