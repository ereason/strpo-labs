<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/phone_title"
            android:textColor="@color/navy"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="@string/phone_instruction"
            android:textColor="@color/navy_muted"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/phoneNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/firstNumber"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:buttonTint="@color/teal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/first_phone_label"
                android:textColor="@color/navy"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/secondNumber"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:buttonTint="@color/teal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/second_phone_label"
                android:textColor="@color/navy"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/thirdNumber"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:buttonTint="@color/teal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/third_phone_label"
                android:textColor="@color/navy"
                android:textSize="18sp" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openDialerButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:text="@string/open_dialer"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/phoneBackButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/back_to_menu"
            android:textAllCaps="false"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
